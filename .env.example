# Environment Configuration for VietCraft

# Node Environment
NODE_ENV=development
PORT=5000

# Database Configuration
# Development (Local MongoDB):
MONGODB_URI=mongodb://127.0.0.1:27017/vietcraft
# Production (MongoDB Atlas connection string):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-endpoint>.mongodb.net/vietcraft?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=vietcraft_super_secret_jwt_key_development_only_change_in_production
JWT_REFRESH_SECRET=vietcraft_super_secret_refresh_jwt_key_development_only_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# URLs for CORS and Redirection
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Media & Image Storage Provider
# Development: STORAGE_PROVIDER=local (saves to apps/api/uploads/ and serves via /uploads/*)
# Production: STORAGE_PROVIDER=cloudinary (uploads to Cloudinary CDN with automatic WebP/AVIF format and quality optimizations)
STORAGE_PROVIDER=local

# Cloudinary Credentials (Required only when STORAGE_PROVIDER=cloudinary)
# Never expose these keys to the frontend bundles or commit real secrets to Git!
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Amazon Affiliate Configuration
AMAZON_ASSOCIATE_TAG=vietcraft-20
AMAZON_API_KEY=your_amazon_paapi_key
AMAZON_API_SECRET=your_amazon_paapi_secret
AMAZON_REGION=us-east-1

# Email Service Provider
EMAIL_PROVIDER_API_KEY=your_email_service_api_key
CONTACT_RECEIVER_EMAIL=hello@vietcraft.com

# Initial Admin Setup (for seed script)
INITIAL_ADMIN_NAME="VietCraft Admin"
INITIAL_ADMIN_EMAIL=admin@vietcraft.com
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!
